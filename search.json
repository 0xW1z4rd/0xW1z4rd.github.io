---
layout: none
---
[{% for post in site.posts %}{"title":{{ post.title | jsonify }},"url":{{ post.url | relative_url | jsonify }},"date":{{ post.date | date: "%B %d, %Y" | jsonify }},"categories":{{ post.categories | jsonify }},"tags":{{ post.tags | jsonify }},"content":{{ post.content | strip_html | normalize_whitespace | truncate: 500 | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
